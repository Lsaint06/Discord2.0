{
  "name": "discord2-server",
  "version": "0.1.0",
  "private": true,
  "description": "Discord 2.0 backend (Fastify + WebSockets)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "admin": "tsx --env-file-if-exists=.env src/cli/admin.ts",
    "bench:argon2": "tsx --env-file-if-exists=.env src/cli/bench-argon2.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "livekit-server-sdk": "^2.19.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
