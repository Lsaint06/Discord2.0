# Copy to .env and adjust. Never commit a real .env.

# Where to listen. 127.0.0.1 keeps the dev server reachable only from this PC.
# Use 0.0.0.0 (or a specific LAN IP) ONLY on a trusted private network.
HOST=127.0.0.1
PORT=3001

# Storage. SQLite path is relative to the server/ directory.
DATABASE_URL=sqlite:./data/discord2.db

# DEVELOPMENT ONLY: password-less identities (anyone can sign in as any username that has no
# password). Password accounts can never be used this way. Defaults to true only in local
# development (npm run dev); Docker Compose defaults to false, and a production server refuses to
# start with it on unless ALLOW_DEV_AUTH_IN_PRODUCTION=true is also set. Never enable it on a
# server reachable from the internet.
DEV_AUTH=false

# ---------------------------------------------------------------------------
# Accounts and sessions (Milestone 7). Leave empty for the defaults shown.
# ---------------------------------------------------------------------------
# A session ends after this many days without use (default 30) ...
SESSION_IDLE_DAYS=
# ... and this many days after sign-in regardless of use (default 90, max 365).
SESSION_MAX_DAYS=
# Argon2id password hashing. Defaults: 65536 KiB (64 MiB), 3 passes, 4 lanes (RFC 9106).
# Must meet the OWASP minimum (19456 KiB with 2 passes). Benchmark on the Jetson:
#   docker compose exec server node dist/cli/bench-argon2.js
ARGON2_MEMORY_KIB=
ARGON2_PASSES=
ARGON2_PARALLELISM=
# Simultaneous hashes (each uses ARGON2_MEMORY_KIB of RAM). Default 2.
ARGON2_MAX_CONCURRENT=

# Extra browser origins allowed for CORS + WebSocket (comma separated).
# The desktop app (1.1+) uses its own origin app://discord2, which is always allowed.
# Electron dev servers on http://localhost:<any port> are allowed automatically in development.
CORS_ORIGINS=
# ALLOW_LOCALHOST_ORIGINS=true
# Desktop apps older than 1.1 load from file:// and send Origin "null". Allowed in development,
# off in production; set true only while such apps still have to connect.
# ALLOW_NULL_ORIGIN=true

# Reverse proxies whose X-Forwarded-For header is believed (IPs, CIDRs or loopback/linklocal/
# uniquelocal). Everything else is ignored, so clients can't fake their IP to dodge rate limits.
# "true" is refused in production. Docker Compose sets Caddy's fixed address (172.30.0.10).
TRUST_PROXY=false

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Attachments (Milestone 6). Leave empty for the defaults shown.
# Files are stored next to the database: <db dir>/attachments (Docker: /data/attachments,
# on the same discord2-data volume). Only set ATTACHMENTS_DIR to move them.
# ---------------------------------------------------------------------------
# ATTACHMENTS_DIR=
# Per-file limits (MB): images (png/jpg/gif/webp) and other files (pdf/txt/zip/...).
UPLOAD_MAX_IMAGE_MB=
UPLOAD_MAX_FILE_MB=
# Files per message (default 5, max 10) and bytes per upload request (default 50 MB).
UPLOAD_MAX_FILES=
UPLOAD_MAX_REQUEST_MB=
# Images with more pixels than this are rejected (default 50 megapixels).
UPLOAD_MAX_IMAGE_MEGAPIXELS=
# Storage quotas: per user (default 1024 MB) and for all attachments (default 20480 MB).
UPLOAD_USER_QUOTA_MB=
UPLOAD_TOTAL_QUOTA_MB=
# Uploads are refused when the volume has less free space than this (default 2048 MB).
UPLOAD_MIN_FREE_DISK_MB=

# ---------------------------------------------------------------------------
# Voice (LiveKit). Leave all four empty to run without voice.
# Generate credentials once, e.g.:
#   docker run --rm livekit/livekit-server:v1.13.11 generate-keys
# Use letters/digits only. The secret must be at least 32 characters and must
# NEVER be put in the desktop app or any RENDERER_VITE_* variable.
# ---------------------------------------------------------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Backend -> LiveKit server API. Local dev: http://127.0.0.1:7880
# (docker-compose.yml sets http://host.docker.internal:7880 automatically; LiveKit uses host networking)
LIVEKIT_URL=
# LiveKit address handed to desktop clients.
#   LAN only:     ws://192.168.68.65:7880
#   Public mode:  wss://<PUBLIC_HOSTNAME>   (Caddy forwards /rtc to LiveKit; ws:// is refused for
#                                            public hosts)
LIVEKIT_PUBLIC_URL=
# Public mode only: signaling URL for PCs that connect on the LAN address (they then don't depend
# on the router looping back to the public IP). Must be a private address.
LIVEKIT_LAN_URL=

# ---------------------------------------------------------------------------
# Docker Compose only (Jetson)
# ---------------------------------------------------------------------------
# LAN address to publish the backend on (127.0.0.1 = this machine only). Jetson: 192.168.68.65
BIND_ADDRESS=127.0.0.1
# LAN-only mode: the address LiveKit advertises to clients (the Jetson's LAN IP).
LIVEKIT_NODE_IP=
# Public mode: true = discover the public IP via STUN (the LAN address is still offered too).
LIVEKIT_USE_EXTERNAL_IP=false
# Addresses LiveKit may offer as its local candidate. Use the Jetson's LAN IP as a /32, e.g.
# 192.168.68.65/32: wider ranges also match other host interfaces (Docker bridges are outside
# 192.168/16, but Jetson's USB-device bridge l4tbr0 is 192.168.55.1).
LIVEKIT_LAN_CIDR=192.168.0.0/16
# Public mode (docker compose --profile public): the DuckDNS name, e.g. myhome.duckdns.org.
# Caddy gets a free Let's Encrypt certificate for it (router must forward TCP 80 and 443).
PUBLIC_HOSTNAME=
