# Template for server/deploy/staging/.env.staging. The real file is created on the Jetson by
# `./stg.sh init-env <LAN IP>` with fresh random keys (mode 600) and is ignored by Git.
# Never put production's LiveKit key or secret here.
STAGING_LAN_IP=192.168.68.65
STAGING_LIVEKIT_API_KEY=APIstg<random>
STAGING_LIVEKIT_API_SECRET=<at least 32 random characters>
