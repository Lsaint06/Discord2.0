# Desktop client configuration (electron-vite env files).
#
# RENDERER_VITE_* values are compiled into the renderer bundle and are PUBLIC.
# Never put secrets, database credentials, or API keys here.
#
# Files (later ones override earlier ones):
#   .env.development        committed default for `npm run dev`
#   .env.development.local  your machine-specific override (git-ignored)
#   .env.production         committed server profiles for release builds (Internet + Home Network)
#   .env.production.local   local override for `npm run build` / `npm run build:win` (git-ignored)
# A shell environment variable with the same name overrides all files.

# Approved servers, "Label|URL" separated by commas (at most 5). The first one is the default;
# with more than one, the sign-in screen shows a picker. Users can't enter any other server, and
# a saved sign-in is only ever used with the server it came from.
#
# Rules (checked at build time; an invalid list fails the build):
#   - https:// for anything on the internet (the app then uses wss:// for realtime and voice)
#   - http:// only for private addresses: 192.168.x.x, 10.x, 172.16-31.x, localhost, *.local, …
#   - just the address, no path
#
# Examples:
#   RENDERER_VITE_SERVERS=Discord 2.0|https://myhome.duckdns.org,Home network|http://192.168.68.65:3001
#   RENDERER_VITE_SERVERS=This PC|http://localhost:3001
RENDERER_VITE_SERVERS=This PC|http://localhost:3001

# Older single-server setting, still accepted when RENDERER_VITE_SERVERS is empty.
# RENDERER_VITE_SERVER_URL=http://localhost:3001

# Optional: only if the LiveKit voice server runs on a DIFFERENT host than the backend.
# Adds that host to the Content-Security-Policy and to the voice addresses the app accepts.
# RENDERER_VITE_LIVEKIT_URL=