# Desktop client configuration (electron-vite env files).
#
# RENDERER_VITE_* values are compiled into the renderer bundle and are PUBLIC.
# Never put secrets, database credentials, or API keys here.
#
# Files (later ones override earlier ones):
#   .env.development        committed default for `npm run dev`
#   .env.development.local  your machine-specific override (git-ignored)
#   .env.production.local   used by `npm run build` (git-ignored)
# A shell environment variable with the same name overrides all files.

# Base URL of the Discord 2.0 backend. Examples:
#   http://localhost:3001          backend on this PC
#   http://192.168.1.50:3001       backend on another PC / Jetson on your LAN
#   https://chat.example.home      backend behind a TLS reverse proxy
RENDERER_VITE_SERVER_URL=http://localhost:3001

# Optional: only if the LiveKit voice server runs on a DIFFERENT host than the backend.
# Adds that host to the Content-Security-Policy. Example: ws://192.168.68.70:7880
# RENDERER_VITE_LIVEKIT_URL=
